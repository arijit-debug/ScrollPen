{
  "name": "scrollpen",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "ScrollPen: a Chrome extension for drawing on web pages and PDFs, with ink that stays on the page",
  "workspaces": [
    "extensions/*"
  ],
  "scripts": {
    "ext:build": "npm run build -w @scrollpen/extension",
    "ext:watch": "npm run watch -w @scrollpen/extension",
    "ext:pack": "npm run pack -w @scrollpen/extension",
    "ext:icons": "npm run icons -w @scrollpen/extension",
    "typecheck": "npm run typecheck -w @scrollpen/extension"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
